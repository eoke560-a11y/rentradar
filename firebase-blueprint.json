{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and account settings for RentRadar Ireland",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "telegramChatId": { "type": "string", "maxLength": 64 },
        "telegramConnected": { "type": "boolean" },
        "emailNotifications": { "type": "boolean" },
        "instantAlerts": { "type": "boolean" },
        "dailySummary": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Property": {
      "title": "Property",
      "description": "Rental property listing discovered across Irish rental portals",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sourceId": { "type": "string", "maxLength": 64 },
        "sourceName": { "type": "string", "maxLength": 64 },
        "originalUrl": { "type": "string", "maxLength": 1024 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 4096 },
        "county": { "type": "string", "maxLength": 64 },
        "city": { "type": "string", "maxLength": 128 },
        "area": { "type": "string", "maxLength": 128 },
        "address": { "type": "string", "maxLength": 256 },
        "monthlyRent": { "type": "number" },
        "bedrooms": { "type": "number" },
        "bathrooms": { "type": "number" },
        "propertyType": { "type": "string", "enum": ["apartment", "house", "studio", "room"] },
        "furnishing": { "type": "string", "enum": ["furnished", "unfurnished", "any"] },
        "berRating": { "type": "string", "maxLength": 10 },
        "images": { "type": "string", "maxLength": 4096 },
        "isDemo": { "type": "boolean" },
        "publishedAt": { "type": "string" },
        "discoveredAt": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      },
      "required": ["id", "title", "monthlyRent", "county", "propertyType", "discoveredAt"]
    },
    "SavedSearch": {
      "title": "SavedSearch",
      "description": "User configured monitoring search criteria for automated property alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "counties": { "type": "string", "maxLength": 512 },
        "town": { "type": "string", "maxLength": 128 },
        "minRent": { "type": "number" },
        "maxRent": { "type": "number" },
        "bedrooms": { "type": "string", "maxLength": 64 },
        "propertyTypes": { "type": "string", "maxLength": 256 },
        "furnishing": { "type": "string", "maxLength": 64 },
        "keywords": { "type": "string", "maxLength": 256 },
        "isActive": { "type": "boolean" },
        "notifyTelegram": { "type": "boolean" },
        "notifyEmail": { "type": "boolean" },
        "matchesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "isActive", "createdAt"]
    },
    "SavedProperty": {
      "title": "SavedProperty",
      "description": "Saved favorite property bookmark for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "propertyId": { "type": "string", "maxLength": 128 },
        "propertyData": { "type": "string", "maxLength": 8192 },
        "notes": { "type": "string", "maxLength": 1024 },
        "savedAt": { "type": "string" }
      },
      "required": ["id", "userId", "propertyId", "savedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Property match alert notification generated by monitoring engine",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "searchId": { "type": "string", "maxLength": 128 },
        "searchName": { "type": "string", "maxLength": 128 },
        "propertyId": { "type": "string", "maxLength": 128 },
        "propertyTitle": { "type": "string", "maxLength": 256 },
        "propertyRent": { "type": "number" },
        "propertyLocation": { "type": "string", "maxLength": 256 },
        "propertyType": { "type": "string", "maxLength": 64 },
        "propertyImage": { "type": "string", "maxLength": 1024 },
        "matchScore": { "type": "number" },
        "matchReason": { "type": "string", "maxLength": 1024 },
        "isRead": { "type": "boolean" },
        "telegramSent": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "propertyId", "propertyTitle", "isRead", "createdAt"]
    },
    "MonitoringSource": {
      "title": "MonitoringSource",
      "description": "Registered data feeds and scraper connectors for property discovery",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["mock_feed", "rss", "api_connector", "feed_sim"] },
        "url": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "enum": ["active", "paused", "error", "degraded"] },
        "pollIntervalMinutes": { "type": "number" },
        "lastCheckedAt": { "type": "string" },
        "propertiesFound": { "type": "number" },
        "errorCount": { "type": "number" },
        "lastError": { "type": "string", "maxLength": 512 }
      },
      "required": ["id", "name", "type", "status"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "grantedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with preferences and Telegram connection"
    },
    "/properties/{propertyId}": {
      "schema": "Property",
      "description": "Discovered rental properties available in Ireland"
    },
    "/savedSearches/{searchId}": {
      "schema": "SavedSearch",
      "description": "Active monitoring searches created by users"
    },
    "/savedProperties/{savedId}": {
      "schema": "SavedProperty",
      "description": "Saved favorite property listings by users"
    },
    "/notifications/{notificationId}": {
      "schema": "NotificationItem",
      "description": "Real-time match notifications for property seekers"
    },
    "/monitoringSources/{sourceId}": {
      "schema": "MonitoringSource",
      "description": "Configured Irish property data monitoring sources"
    },
    "/admins/{adminId}": {
      "schema": "AdminRole",
      "description": "Designated administrator credentials"
    }
  }
}
